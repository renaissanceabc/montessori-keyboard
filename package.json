{
  "name": "montessori-keyboard",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:site": "bun run --cwd apps/site dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:swift": "cd apps/ios && xcrun swift-format lint --strict --recursive --configuration .swift-format Sources Tests Project.swift Tuist.swift && swiftlint lint --strict --quiet",
    "format:swift": "cd apps/ios && xcrun swift-format format --in-place --recursive --configuration .swift-format Sources Tests Project.swift Tuist.swift",
    "ios:generate": "bun run --cwd apps/ios ios:generate",
    "ios:build": "bun run --cwd apps/ios ios:build",
    "ios:test": "bun run --cwd apps/ios ios:test",
    "icons": "python3 scripts/icons.py",
    "og-images": "python3 scripts/og-images.py",
    "site-font": "python3 scripts/site-font.py",
    "commitlint": "commitlint",
    "prepare": "git rev-parse --is-inside-work-tree > /dev/null 2>&1 && { git config --unset core.hooksPath; lefthook install; } || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@socketsecurity/bun-security-scanner": "1.1.3",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "turbo": "^2.6.0"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "typescript": "~7.0.2",
    "@types/node": "^26.6.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "16.4.5",
    "vitest": "^5.0.3"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
