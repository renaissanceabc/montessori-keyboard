default_platform(:ios)

# Must match `bundleIdPrefix` in apps/ios/Project.swift.
APP_ID = "com.renaissance.montessorikeyboard"
KEYBOARD_ID = "#{APP_ID}.keyboard"
APP_GROUP = "group.#{APP_ID}"
TEAM_ID = "6P8L9SND3U"
WORKSPACE = "MontessoriKeyboard.xcworkspace"
XCODEPROJ = "MontessoriKeyboard.xcodeproj"
IPA = "build/MontessoriKeyboard.ipa"

# Each signed target and the bundle id its App Store profile is for.
SIGNED_TARGETS = {
  "MontessoriKeyboard" => APP_ID,
  "Keyboard" => KEYBOARD_ID,
}.freeze

platform :ios do
  before_all do
    # gym's error handler trips on non-UTF-8 bytes in xcodebuild output under a US-ASCII locale.
    ENV["LANG"] ||= "en_US.UTF-8"
    ENV["LC_ALL"] ||= "en_US.UTF-8"
    setup_ci if is_ci
  end

  desc "One-time, on a Mac, after the app ids, App Group and App Store Connect app exist"
  desc "(apps/ios/README.md, TestFlight): make the App Store profiles in the match repo."
  desc "Signs in with the App Store Connect API key, never an Apple ID, so 2FA and federated"
  desc "accounts don't matter. Usage: bundle exec fastlane setup"
  lane :setup do
    match(type: "appstore", app_identifier: SIGNED_TARGETS.values, readonly: false, api_key: asc_api_key)
  end

  desc "Generate the Xcode project with Tuist."
  lane :generate do
    sh("cd .. && tuist generate --no-open")
  end

  desc "Archive and sign an App Store build. Writes #{IPA}. No upload."
  lane :archive do
    generate

    # Only downloads what `setup` made, so it needs no login.
    match(type: "appstore", app_identifier: SIGNED_TARGETS.values, readonly: true)

    # Project.swift signs automatically for local runs. An App Store build uses match's profiles.
    SIGNED_TARGETS.each do |target, id|
      update_code_signing_settings(
        path: XCODEPROJ,
        targets: [target],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: "match AppStore #{id}",
      )
    end

    # MARKETING_VERSION comes from Project.swift. The build number is a timestamp, so every
    # upload is unique without a commit; both Info.plists read CURRENT_PROJECT_VERSION.
    build_number = Time.now.utc.strftime("%Y%m%d%H%M")

    build_app(
      workspace: WORKSPACE,
      scheme: "MontessoriKeyboard",
      configuration: "Release",
      output_directory: "build",
      output_name: File.basename(IPA),
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: SIGNED_TARGETS.values.to_h { |id| [id, "match AppStore #{id}"] },
      },
    )

    UI.success("Archived build #{build_number}.")
  end

  desc "Upload an IPA to TestFlight. Usage: bundle exec fastlane upload ipa:#{IPA}"
  lane :upload do |options|
    ipa = File.expand_path(options[:ipa] || IPA, File.expand_path("..", __dir__))

    upload_to_testflight(
      ipa: ipa,
      api_key: asc_api_key,
      # Internal testers get it once Apple finishes processing. Waiting here would bill macOS
      # minutes for 5 to 15 idle ones, so the run ends at upload (and sets no "What to Test" note,
      # which needs the processed build).
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Archive, then upload. What the TestFlight workflow runs."
  lane :release do
    archive
    upload
  end

  # CI passes the key as base64 (a secret). On a Mac, APP_STORE_CONNECT_API_KEY_PATH can point
  # at the .p8 file instead.
  private_lane :asc_api_key do
    key = { key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"), issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID") }
    if ENV["APP_STORE_CONNECT_API_KEY_PATH"]
      app_store_connect_api_key(**key, key_filepath: File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_PATH"]))
    else
      app_store_connect_api_key(**key, key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64"), is_key_content_base64: true)
    end
  end
end
