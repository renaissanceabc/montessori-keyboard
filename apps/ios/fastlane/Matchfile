# Signing certificates and profiles live in an encrypted git repo. Every Renaissance app shares one
# repo and one App Store distribution certificate (Apple allows only a few per team), so this
# defaults to it. Set MATCH_GIT_URL to use another one.
git_url(ENV.fetch("MATCH_GIT_URL", "https://github.com/renaissanceabc/apple-certificates.git"))
storage_mode("git")
type("appstore")

app_identifier([
  "com.renaissance.montessorikeyboard",
  "com.renaissance.montessorikeyboard.keyboard",
])

team_id("6P8L9SND3U")
