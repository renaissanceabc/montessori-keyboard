{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "import", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    ".claude/**",
    ".devkit/**",
    "**/.next/**",
    "**/out/**",
    "**/next-env.d.ts",
    "apps/site/public/**",
    "apps/site/components/stageshow/**",
    "apps/ios/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "oxc/no-accumulating-spread": "error",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ]
  }
}
